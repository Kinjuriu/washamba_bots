.venv/
.ipynb_checkpoints/
__pycache__/
*.pyc

# Episode replays are multi-MB per game — keep them out of history
replay*.json
experiments/*.json

# Personal working files — not shared with the team
/mydocs/

# Replay JSONs pulled from the host episode dumps (~30MB each)
replays/
*.json.zip

# Fetched on demand by experiments/meta_opponent.py - never committed.
experiments/.meta_agent.py
experiments/.meta_kernel/

# Fetched on demand by experiments/route_v20.py - never committed.
experiments/.v20_agent.py
experiments/.v20_kernel/
experiments/.decoded/
experiments/.kernel_cache/

# destbreso's recorded-matchup benchmark dataset, pulled on demand by
# experiments/gate.py's `benchmark` mode - never committed (third-party
# Kaggle dataset, and large). Download with:
#   kaggle datasets download -d destbreso/kaggriculture-benchmark-matchups \
#       -p data/benchmark --unzip
data/benchmark/

# pull_episodes.py output. --out is required and refuses to resolve inside
# this repo, but these patterns stay as a defensive backstop - the real
# dataset belongs in ~/KagricultureLocalData/episodes, outside iCloud sync.
data/episodes/
KagricultureLocalData/
*.json.gz
*.part
manifest.csv
teams.json

# Credentials - never committed, regardless of how they got here.
.env
.env.*
*.cookie
KAGGLE_COOKIE*
