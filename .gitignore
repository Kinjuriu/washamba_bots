.venv/
.ipynb_checkpoints/
__pycache__/
*.pyc

# Episode replays are multi-MB per game — keep them out of history
replay*.json
experiments/*.json

# Personal working files — not shared with the team.
# The living spec, diary, method, tool list, and v20 tapes *are* the
# session flow: another checkout cannot run tape_profile.py or pick up
# T1 without them. Scratch / old plan notes stay local.
/mydocs/*
!/mydocs/FACTS.md
!/mydocs/AGENT_BUILDING_PROTOCOL.md
!/mydocs/HANDOFF.md
!/mydocs/TOOLS_GUIDE.md
!/mydocs/tape_transcripts/

# Replay JSONs pulled from the host episode dumps (~30MB each)
replays/
*.json.zip

# Fetched on demand by experiments/meta_opponent.py - never committed.
experiments/.meta_agent.py
experiments/.meta_kernel/

# Fetched on demand by experiments/route_v20.py - never committed.
experiments/.v20_agent.py
experiments/.v20_kernel/

# The animal-first shape throwaway (mydocs/FACTS.md) is versioned on
# purpose: seven sessions of "audit CLEAR" hid a falling contested bank and
# there was no earlier revision to bisect against. Keep it tracked.
# experiments/_facts_v20.py

# Throwaway MAX_ANIMALS=5 copy and cliff-trace helper. Never commit.
experiments/_max5.py
experiments/_max10.py
experiments/_tape_cal.py
experiments/_cliff_dump.py
experiments/_facts_v20_pre_f20.py
experiments/_facts_dump.py
experiments/_facts_trace.py
experiments/_facts_loss_diag.py
experiments/_facts_seed8.py
experiments/_facts_escape.py
experiments/_facts_feed_miss.py
experiments/_facts_leftover.py
